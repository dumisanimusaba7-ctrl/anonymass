# Supabase project settings (Project Settings → API).
# The anon / publishable key is designed to be public: the database only
# exposes the game functions, never the tables.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Optional: absolute URL used in Open Graph tags. On Netlify the deploy URL is
# picked up automatically; set this for a custom domain.
# VITE_SITE_URL=https://anonymass.com

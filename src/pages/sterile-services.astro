---
import { Image } from 'astro:assets'
import Base from '../layouts/Base.astro'
import Breadcrumbs from '../components/Breadcrumbs.astro'
import AddToQuote from '../components/AddToQuote.astro'
import Plate from '../components/Plate.astro'
import { departmentBySlug } from '../data/catalogue'
import { whatsappLink } from '../data/site'

const d = departmentBySlug('sterile-services')!
const cat = (slug: string) => d.categories.find((c) => c.slug === slug)!

const stations = [
  {
    step: 'Pack',
    category: cat('packing-tables'),
    text: 'Clean instruments are checked and wrapped at a packing table, with wrap and pouch rolls in reach and trays on the shelf below.',
  },
  {
    step: 'Seal',
    category: cat('pouch-sealers'),
    text: 'Items in sterilisation pouches go through a heat sealer, so the pouch stays closed through the autoclave cycle.',
  },
  {
    step: 'Sterilise',
    category: cat('autoclaves'),
    text: 'Sealed packs are loaded into the autoclave and run through a steam cycle.',
    service: true,
  },
  {
    step: 'Store',
    category: cat('sterile-storage-shelving'),
    text: 'Sterile packs wait on open wire shelving that air can move through, until theatre or the ward asks for them.',
  },
]
const extras = [cat('stainless-furniture'), cat('medical-fridges')]
---

<Base
  title="Sterile services equipment and autoclave maintenance | Optima, Kitwe"
  image="/og/sterile-room.jpg"
  imageAlt="Optima Medical Supplies: sterile services equipment and autoclave maintenance"
  description="Packing tables, pouch sealers, autoclaves and sterile shelving for sterile services departments, plus autoclave installation and maintenance, from Optima in Kitwe, Zambia."
>
  <section class="ss-hero on-indigo">
    <div class="container ss-hero__grid">
      <div>
        <Breadcrumbs trail={[{ href: '/', label: 'Home' }, { label: 'Sterile services' }]} />
        <h1 transition:name="dept-title-sterile-services">From the packing table to the sterile store</h1>
        <p class="lead">
          Optima supplies the equipment for each step of a sterile services room, and installs and maintains autoclaves.
        </p>
        <div class="ss-hero__actions">
          <a class="btn btn--light" href={whatsappLink('Hello Optima, I would like to book an autoclave visit for: ')}>
            Book an autoclave visit
          </a>
          <a class="btn btn--outline-light" href="#flow">See each step</a>
        </div>
      </div>
      <div class={`lens lens--${d.fit} ss-hero__lens`} transition:name="dept-img-sterile-services">
        <Image src={d.image} alt={d.alt} widths={[240, 339]} sizes="(min-width: 1024px) 320px, 60vw" loading="eager" fetchpriority="high" />
      </div>
    </div>
  </section>

  <section class="section" id="flow" aria-labelledby="flow-title">
    <div class="container">
      <h2 id="flow-title" class="visually-hidden">Steps in a sterile services room</h2>
      <div class="cssd" data-cssd>
        <div class="cssd__track" aria-hidden="true"><div class="cssd__fill" data-cssd-fill></div></div>
        <ol class="cssd__list">
        {
          stations.map((s, i) => (
            <li class="cssd__station" data-cssd-station>
              <span class="cssd__dot" aria-hidden="true" />
              <div class="cssd__head">
                <span class="cssd__num">Step {i + 1}</span>
                <h3 class="cssd__step">{s.step}</h3>
              </div>
              <div class="cssd__card">
                <div class="cssd__img">
                  <Image
                    src={s.category.image}
                    alt={s.category.alt}
                    widths={[240, s.category.image.width]}
                    sizes="(min-width: 768px) 280px, 70vw"
                    style={`--max-w:${Math.round(s.category.image.width * 1.5)}px`}
                  />
                </div>
                <div class="cssd__text">
                  <h4>{s.category.name}</h4>
                  <p>{s.text}</p>
                  <p class="cssd__shown">{s.category.shown}</p>
                  {s.service && (
                    <div class="cssd__service">
                      <strong>Installation and maintenance.</strong> We install autoclaves and maintain them. Tell us the make,
                      model and town.
                    </div>
                  )}
                  <div class="cssd__actions">
                    <AddToQuote id={s.category.slug} name={s.category.name} group={d.name} />
                    {s.service && (
                      <a class="link-arrow" href={whatsappLink('Hello Optima, I would like to book an autoclave visit for: ')}>
                        <span class="link-arrow__text">Book a visit</span>
                        <span aria-hidden="true">→</span>
                      </a>
                    )}
                  </div>
                </div>
              </div>
            </li>
          ))
        }
        </ol>
      </div>
    </div>
  </section>

  <section class="section ss-more" aria-labelledby="more-title">
    <div class="container">
      <h2 id="more-title" data-reveal>Storage around the room</h2>
      <p class="lead" data-reveal>Closed storage for sterile stock, and fridges for medicines and samples.</p>
      <div class="ss-more__grid">
        {
          extras.map((c, i) => (
            <div data-reveal style={`--reveal-delay:${i * 60}ms`}>
              <Plate category={c} department={d} />
            </div>
          ))
        }
      </div>
    </div>
  </section>
</Base>

<style>
  .ss-hero {
    padding-block: var(--s-6) var(--s-8);
  }
  .ss-hero :global(.crumbs) {
    --muted: var(--on-indigo-muted);
  }
  .ss-hero :global(.crumbs a) {
    color: #fff;
  }
  .ss-hero :global(.crumbs li + li::before) {
    color: var(--on-indigo-muted);
  }
  .ss-hero__grid {
    display: grid;
    gap: var(--s-7);
    align-items: center;
  }
  @media (min-width: 768px) {
    .ss-hero__grid {
      grid-template-columns: 7fr 4fr;
    }
  }
  .ss-hero h1 {
    max-width: 14ch;
  }
  .ss-hero .lead {
    margin-top: var(--s-4);
    color: #e6e7f5;
  }
  .ss-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    margin-top: var(--s-6);
  }
  .ss-hero__lens {
    width: min(60vw, 320px);
    margin-inline: auto;
  }

  /* Flow with a progress line that fills as you scroll. */
  .cssd {
    --rail: 20px;
    position: relative;
    padding: 0 0 0 calc(var(--rail) + var(--s-5));
    max-width: 980px;
  }
  .cssd__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--s-8);
  }
  @media (min-width: 768px) {
    .cssd {
      --rail: 28px;
      padding-left: calc(var(--rail) + var(--s-7));
    }
  }
  .cssd__track {
    position: absolute;
    left: calc(var(--rail) / 2);
    top: 14px;
    bottom: 14px;
    width: 2px;
    background: var(--border);
  }
  .cssd__fill {
    position: absolute;
    inset: 0;
    background: var(--indigo);
    transform-origin: top;
    transform: scaleY(var(--p, 0));
  }
  .cssd__station {
    position: relative;
  }
  .cssd__dot {
    position: absolute;
    left: calc((var(--rail) + var(--s-5)) * -1);
    top: 10px;
    width: var(--rail);
    height: var(--rail);
    border-radius: 50%;
    background: var(--bg);
    border: 2px solid var(--border-strong);
    transition:
      background-color var(--dur-2) var(--ease-out),
      border-color var(--dur-2) var(--ease-out);
  }
  @media (min-width: 768px) {
    .cssd__dot {
      left: calc((var(--rail) + var(--s-7)) * -1);
    }
  }
  .cssd__station.is-reached .cssd__dot {
    background: var(--indigo);
    border-color: var(--indigo);
  }
  .cssd__head {
    display: flex;
    align-items: baseline;
    gap: var(--s-3);
    margin-bottom: var(--s-4);
  }
  .cssd__num {
    font-size: var(--fs-small);
    color: var(--muted);
  }
  .cssd__step {
    font-size: clamp(2.5rem, 6vw, 4rem);
    color: #7a7f9f;
    transition: color var(--dur-3) var(--ease-out);
  }
  .cssd__station.is-reached .cssd__step {
    color: var(--navy);
  }
  .cssd__card {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--s-5);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--r-3);
    padding: var(--s-5);
  }
  @media (min-width: 768px) {
    .cssd__card {
      grid-template-columns: 280px 1fr;
      align-items: center;
    }
  }
  .cssd__img {
    position: relative;
    aspect-ratio: 1;
    background: #fff;
    overflow: hidden;
  }
  .cssd__img :global(img) {
    position: absolute;
    inset: 0;
    margin: auto;
    width: auto;
    height: auto;
    max-width: min(100%, var(--max-w, 100%));
    max-height: 100%;
  }
  .cssd__text {
    display: grid;
    gap: var(--s-3);
    justify-items: start;
  }
  .cssd__text h4 {
    font-size: 1.75rem;
    color: var(--navy);
  }
  .cssd__shown {
    font-size: var(--fs-small);
    color: var(--muted);
  }
  .cssd__service {
    padding: var(--s-3) var(--s-4);
    background: var(--sky-100);
    border: 1px solid var(--sky);
    border-radius: var(--r-2);
    color: var(--navy);
  }
  .cssd__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-4);
    margin-top: var(--s-2);
  }

  .ss-more {
    background: var(--surface);
    border-top: 1px solid var(--border);
  }
  .ss-more .lead {
    color: var(--muted);
    margin: var(--s-3) 0 var(--s-6);
  }
  .ss-more__grid {
    display: grid;
    gap: var(--s-5);
  }
  @media (min-width: 640px) {
    .ss-more__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      max-width: 820px;
    }
  }
  .ss-more__grid > div {
    display: grid;
  }
</style>

<script>
  import { onPage, clamp, reducedMotion } from '../scripts/motion'

  onPage(() => {
    const list = document.querySelector<HTMLElement>('[data-cssd]')
    if (!list) return
    const fill = list.querySelector<HTMLElement>('[data-cssd-fill]')!
    const stations = [...list.querySelectorAll<HTMLElement>('[data-cssd-station]')]
    let frame = 0
    const update = () => {
      frame = 0
      const rect = list.getBoundingClientRect()
      // The line's tip sits 60% down the screen.
      const tip = window.innerHeight * 0.6
      const p = reducedMotion() ? 1 : clamp((tip - rect.top) / rect.height)
      fill.style.setProperty('--p', p.toFixed(4))
      const tipY = rect.top + p * rect.height
      stations.forEach((s) => s.classList.toggle('is-reached', s.getBoundingClientRect().top + 20 <= tipY))
    }
    const onScroll = () => {
      if (!frame) frame = requestAnimationFrame(update)
    }
    window.addEventListener('scroll', onScroll, { passive: true })
    window.addEventListener('resize', onScroll)
    update()
    return () => {
      window.removeEventListener('scroll', onScroll)
      window.removeEventListener('resize', onScroll)
      cancelAnimationFrame(frame)
    }
  })
</script>

---
import Base from '../layouts/Base.astro'
import Mark from '../components/Mark.astro'
---

<Base title="Page not found | Optima Medical Supplies" description="This page is not in the catalogue." noindex waveOn="indigo">
  <section class="nf on-indigo">
    <div class="container nf__inner">
      <Mark size={120} />
      <h1>This page isn’t in the catalogue</h1>
      <p class="lead">The link may be old or mistyped. Everything we supply is on the products page.</p>
      <div class="nf__actions">
        <a class="btn btn--light" href="/products">Browse products</a>
        <a class="btn btn--outline-light" href="/">Go to the home page</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .nf {
    padding-block: var(--s-9);
    background: var(--indigo-800);
  }
  .nf__inner {
    display: grid;
    gap: var(--s-5);
    justify-items: start;
  }
  .nf h1 {
    max-width: 14ch;
  }
  .nf .lead {
    color: #e6e7f5;
  }
  .nf__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
  }
</style>

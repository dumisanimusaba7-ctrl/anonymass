---
import '@fontsource/saira-extra-condensed/600.css'
import '@fontsource/saira-extra-condensed/700.css'
import '@fontsource-variable/jost/wght.css'
import '../styles/global.css'
import { ClientRouter } from 'astro:transitions'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import MobileBar from '../components/MobileBar.astro'
import { address, company, emails, fax, phones } from '../data/site'

interface Props {
  title: string
  description: string
  /** Link-preview card in /public/og (1200×630 JPEG). */
  image?: string
  /** Describes the preview card for screen readers on social sites. */
  imageAlt?: string
  noindex?: boolean
  /** Background of the last section, so the footer wave meets it cleanly. */
  waveOn?: 'light' | 'indigo'
}

const {
  title,
  description,
  image = '/og/home.jpg',
  imageAlt = 'Optima Medical Supplies, Kitwe: ward, theatre and lab supplies',
  noindex = false,
  waveOn = 'light',
} = Astro.props
const path = Astro.url.pathname.replace(/\/$/, '') || '/'
const canonical = new URL(path, Astro.site)
const ogImage = new URL(image, Astro.site)
const fullTitle = title.includes('Optima') ? title : `${title} | Optima Medical Supplies`

const localBusiness = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: company.legalName,
  description: 'Medical equipment, hospital furniture, consumables and laboratory ware.',
  url: Astro.site?.toString(),
  image: ogImage.toString(),
  telephone: phones[0].display,
  faxNumber: fax.display,
  email: emails[0],
  address: {
    '@type': 'PostalAddress',
    streetAddress: address.street,
    addressLocality: address.town,
    addressCountry: address.countryCode,
  },
}
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#333399" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Optima Medical Supplies" />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    {ogImage.protocol === 'https:' && <meta property="og:image:secure_url" content={ogImage} />}
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <script type="application/ld+json" set:html={JSON.stringify(localBusiness)} />
    <ClientRouter fallback="animate" />
    <slot name="head" />
  </head>
  <body>
    <div class="nav-progress" data-nav-progress transition:persist="nav-progress" aria-hidden="true"><span></span></div>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main" transition:name="main">
      <slot />
    </main>
    <Footer waveOn={waveOn} />
    <MobileBar />
    <div class="quote-live visually-hidden" aria-live="polite" transition:persist="quote-live"></div>
  </body>
</html>

<script>
  import '../scripts/reveal'
  import '../scripts/quote-ui'
  import '../scripts/scroller'
</script>

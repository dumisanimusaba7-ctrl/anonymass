---
interface Props {
  trail: { href?: string; label: string }[]
}
const { trail } = Astro.props
---

<nav class="crumbs" aria-label="Breadcrumb">
  <ol>
    {
      trail.map((c, i) => (
        <li>
          {c.href && i < trail.length - 1 ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}
        </li>
      ))
    }
  </ol>
</nav>

<style>
  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    list-style: none;
    margin: 0 0 var(--s-5);
    padding: 0;
    font-size: var(--fs-small);
    color: var(--muted);
  }
  .crumbs li + li::before {
    content: '/';
    margin-right: var(--s-2);
    color: var(--border-strong);
  }
  .crumbs a {
    color: var(--navy);
  }
</style>

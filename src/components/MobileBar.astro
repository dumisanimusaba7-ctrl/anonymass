---
import { phones, whatsappLink } from '../data/site'
---

<nav class="mobile-bar" aria-label="Quick contact" transition:persist="mobile-bar">
  <a href={phones[0].href}>
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.6 3.5 9 3l1.6 4-2 1.3a11 11 0 0 0 7.1 7.1L17 13.4l4 1.6-.5 2.4a2 2 0 0 1-2 1.6A15.6 15.6 0 0 1 5 5.5a2 2 0 0 1 1.6-2z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"></path></svg>
    Call
  </a>
  <a href={whatsappLink('Hello Optima, I would like a quote for:')}>
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20l1.2-3.6A8 8 0 1 1 8 19z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"></path><path d="M9.2 8.6c.2-.4.6-.4.8 0l.6 1.3c.1.3 0 .5-.2.7l-.4.4a5 5 0 0 0 2.6 2.6l.4-.4c.2-.2.5-.3.7-.2l1.3.6c.4.2.4.6 0 .8-.5.4-1.1.7-1.8.6a6.4 6.4 0 0 1-4.6-4.6c-.1-.7.2-1.3.6-1.8z" fill="currentColor"></path></svg>
    WhatsApp
  </a>
  <a href="/quote" class="mobile-bar__quote">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 3h10l2 2v16H5V5z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"></path><path d="M9 9h6M9 13h6M9 17h3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path></svg>
    <span>Quote <span data-quote-count data-count="0" class="mobile-bar__count">0</span></span>
  </a>
</nav>

<style>
  :global(:root) {
    --mobile-bar-h: 64px;
  }
  @media (min-width: 768px) {
    :global(:root) {
      --mobile-bar-h: 0px;
    }
  }
  .mobile-bar {
    position: fixed;
    inset: auto 0 0 0;
    z-index: 30;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    height: calc(var(--mobile-bar-h) + env(safe-area-inset-bottom));
    padding-bottom: env(safe-area-inset-bottom);
    background: var(--surface);
    border-top: 1px solid var(--border);
  }
  @media (min-width: 768px) {
    .mobile-bar {
      display: none;
    }
  }
  .mobile-bar a {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2px;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--navy);
    text-decoration: none;
  }
  .mobile-bar a + a {
    border-left: 1px solid var(--border);
  }
  .mobile-bar svg {
    width: 22px;
    height: 22px;
  }
  .mobile-bar__count {
    display: inline-grid;
    place-items: center;
    min-width: 18px;
    height: 18px;
    padding: 0 5px;
    margin-left: 2px;
    border-radius: 9px;
    background: var(--border);
    color: var(--navy);
    font-size: 0.75rem;
    font-variant-numeric: tabular-nums;
  }
  .mobile-bar__count:not([data-count='0']) {
    background: var(--red);
    color: #fff;
  }
  .mobile-bar__count.is-bumped {
    animation: count-bump 360ms var(--ease-out);
  }
  @keyframes count-bump {
    40% {
      transform: scale(1.35);
    }
  }
</style>
